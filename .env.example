# Sao chép thành .env rồi điền. Tệp .env không được đưa lên git.
# Có thể bỏ trống tất cả: chọn nhà cung cấp và nhập khóa ngay trong app ở
# Cấu hình hệ thống > API (lưu ở data/ai-settings.json, cũng không lên git).
# Khóa nhập trong app thắng khóa ở đây; khóa ở đây thắng biến môi trường Windows.

# Khóa Claude API (https://platform.claude.com). Có khóa này mà chưa chọn gì trong app thì app dùng Claude.
ANTHROPIC_API_KEY=

# Nhà cung cấp khác (tùy chọn)
# OPENAI_API_KEY=             # https://platform.openai.com/api-keys
# GEMINI_API_KEY=             # https://aistudio.google.com/apikey
# DEEPSEEK_API_KEY=           # https://platform.deepseek.com/api_keys

# Tên model (tùy chọn, để trống thì dùng mặc định)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
# GEMINI_MODEL=gemini-2.5-pro
# DEEPSEEK_MODEL=deepseek-chat
# CLAUDE_EFFORT=medium        # low | medium | high

# Khác
# PORT=5173
# VITE_AI_MODE=mock           # ép dùng AI giả lập dù có khóa
